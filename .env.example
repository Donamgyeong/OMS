# Copy to .env. Compose reads this file; local Python does not automatically load it.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-before-running
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,oms.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://oms.example.com
DJANGO_SECURE_SSL_REDIRECT=1
# Enable only behind a trusted proxy which overwrites X-Forwarded-Proto.
DJANGO_TRUST_PROXY=1
POSTGRES_DB=oms
POSTGRES_USER=oms
POSTGRES_PASSWORD=replace-with-a-random-database-password
APP_IMAGE=oms:local
APP_PORT=8000
GUNICORN_WORKERS=1
GUNICORN_THREADS=2
# Required before production startup. Register a single-tenant Web application.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=
# Example redirect: https://oms.example.com/accounts/entra/callback/
# App role OMS.Access must be assigned to the OMS-Users employee group.
# Default logout clears OMS only. Enable Microsoft logout only after UX testing.
ENTRA_LOGOUT_MICROSOFT=0
ENTRA_POST_LOGOUT_REDIRECT_URI=
# Teams-managed notification bot: separate credentials from OMS browser SSO.
# Keep disabled until the bot and personal-scope app installation are ready.
TEAMS_ENABLED=0
TEAMS_TENANT_ID=
TEAMS_CLIENT_ID=
TEAMS_CLIENT_SECRET=
OMS_PUBLIC_URL=
# Example: https://oms.example.com (origin only, no trailing slash)
# Messaging endpoint: https://oms.example.com/api/teams/messages/

# Microsoft Graph company holiday calendar (read-only application access)
HOLIDAY_TENANT_ID=
HOLIDAY_CLIENT_ID=
HOLIDAY_CLIENT_SECRET=
HOLIDAY_MAILBOX=
HOLIDAY_CALENDAR_ID=

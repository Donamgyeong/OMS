# Copy to .env for compose.cloudflare.yaml. This is a template, not live configuration.
# Replace oms.example.com consistently below and in the Entra Web redirect URI.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-before-running
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,oms.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://oms.example.com
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_TRUST_PROXY=1
POSTGRES_DB=oms
POSTGRES_USER=oms
POSTGRES_PASSWORD=replace-with-a-random-database-password
APP_IMAGE=oms:local
GUNICORN_WORKERS=1
GUNICORN_THREADS=2
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=https://oms.example.com/accounts/entra/callback/
ENTRA_LOGOUT_MICROSOFT=0
ENTRA_POST_LOGOUT_REDIRECT_URI=
# Pin updates deliberately after verification; ARM64 official Cloudflare image.
CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.10.3
# auto uses QUIC, with HTTP/2 fallback. Set http2 if UDP 7844 is blocked.
CLOUDFLARED_PROTOCOL=auto
# Put ONLY the connector token in this file. Never put the token in this .env.
CLOUDFLARE_TUNNEL_TOKEN_FILE=./secrets/cloudflared-token
